<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <style>
        body { font-family: sans-serif; margin: 0; padding: 0; background-color: #f8f9fa; }
        .navbar { background-color: #343a40; padding: 0.8rem 1.5rem; display: flex; justify-content: space-between; align-items: center; }
        .navbar a { color: white; text-decoration: none; padding: 0.5rem; }
        .navbar .brand { font-size: 1.2rem; font-weight: bold; }
        .navbar .logout-link { background-color: #dc3545; border-radius: 4px; padding: 0.4rem 0.8rem; }
        .navbar .logout-link:hover { background-color: #c82333; }
        .container { max-width: 960px; margin: 2rem auto; padding: 2rem; background-color: #fff; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        h1 { color: #333; }
        .admin-link { display: inline-block; margin-top: 1rem; padding: 0.6rem 1rem; background-color: #17a2b8; color: white; text-decoration: none; border-radius: 4px; }
        .admin-link:hover { background-color: #138496; }
    </style>
</head>
<body>
    <nav class="navbar">
        <a href="/home" class="brand">Ery Project</a>
        <div>
            <span style="color: #ccc; margin-right: 1rem;">Hola, <%= user.username %>!</span>
            <a href="/logout" class="logout-link">Cerrar Sesión</a>
        </div>
    </nav>

    <div class="container">
        <h1>Bienvenido a Ery, <%= user.username %></h1>
        <p>Has iniciado sesión correctamente.</p>
        <p>Tu rol es: <strong><%= user.role %></strong></p>

        <% if (user.role === 'admin') { %>
            <a href="/admin/users" class="admin-link">Gestionar Usuarios (Admin)</a>
        <% } %>

    </div>

    </body>
</html>
