<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error 404 - Página No Encontrada</title>
    <style>
        body {
            font-family: sans-serif;
            background-color: #f8f9fa;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            text-align: center;
            color: #6c757d;
            margin: 0;
        }
        .container {
            background-color: #fff;
            padding: 3rem 4rem;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .icon {
            font-size: 6rem; /* Tamaño grande para el icono */
            margin-bottom: 1rem;
            color: #ffc107; /* Color amarillo advertencia */
        }
        h1 {
            font-size: 2.5rem;
            color: #dc3545; /* Color rojo error */
            margin-bottom: 0.5rem;
        }
        p {
            font-size: 1.2rem;
            margin-bottom: 2rem;
        }
        .btn-home {
            display: inline-block;
            padding: 0.8rem 1.8rem;
            background-color: #007bff;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-size: 1rem;
            transition: background-color 0.2s ease;
        }
        .btn-home:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="icon">🚧</div>
        <h1>Error 404</h1>
        <p>Ery Project no está por aquí.</p>
        <a href="/home" class="btn-home">Volver al Inicio</a>
    </div>
</body>
</html>
